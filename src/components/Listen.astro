---
import { site, t, type Lang } from '../lib/content';
import { router } from '../lib/routes';
import Section from './Section.astro';
import Marquee from './Marquee.astro';
import SoundCloudFacade from './SoundCloudFacade.astro';
import Disc from './Disc.astro';
import Glitch from './Glitch.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { tracks, featured, profile_url } = site.listen;
const hero = tracks.find((x) => x.id === featured);
const kindLabel = (k: string) => (k === 'track' ? t('listen_kind_track', lang) : k === 'set' ? t('listen_kind_set', lang) : '');
---

<Section id="escuchar" title={t('listen_title', lang)}>
  {
    hero && (
      <div class="listen__marquee" data-reveal>
        <Marquee text={hero.title} lang={lang} />
      </div>
    )
  }
  <div class="listen__grid" class:list={{ 'listen__grid--single': !hero || tracks.length === 0 }}>
    {
      hero && (
        <div class="listen__player" id="player" data-reveal data-disc-scope data-disc-state="idle">
          <div class="listen__head">
            <h3 class="label listen__label">{t('listen_player', lang)}</h3>
            <Disc class="listen__seal" />
          </div>
          <SoundCloudFacade title={hero.title} url={hero.url} lang={lang} />
        </div>
      )
    }
    {
      tracks.length > 0 && (
        <div class="listen__list" data-reveal style="--reveal-delay:120ms">
          <h3 class="label listen__label">{t('listen_list', lang)}</h3>
          <ol class="tracks">
            {tracks.map((tr) => (
              <li class:list={['track', { 'track--featured': tr.id === featured }]}>
                <a class="track__link" href={tr.url} target="_blank" rel="noopener noreferrer" data-glitch-host>
                  <span class="track__n label" aria-hidden="true"></span>
                  <span class="track__title">
                    <Glitch text={tr.title} block><span class="track__name">{tr.title}</span></Glitch>
                    {kindLabel(tr.kind) && <span class="track__kind label"> · {kindLabel(tr.kind)}</span>}
                  </span>
                  <span class="track__arrow arrow" aria-hidden="true">↗</span>
                  <span class="sr-only">{t('new_tab', lang)}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
  {
    (profile_url || router.listed('mixes')) && (
      <p class="listen__all" data-reveal>
        {router.listed('mixes') && (
          <a class="btn btn--primary" href={router.path('mixes', lang)}>
            {t('home_mixes_all', lang)} <span class="arrow" data-dir="right" aria-hidden="true">→</span>
          </a>
        )}
        {profile_url && <a class="btn" href={profile_url} target="_blank" rel="noopener noreferrer">
          {t('listen_view_all', lang)} <span class="arrow" aria-hidden="true">↗</span><span class="sr-only"> {t('new_tab', lang)}</span>
        </a>}
      </p>
    )
  }
</Section>

<style>
  .listen__marquee { margin-bottom: var(--space-xl); }
  .listen__grid { display: grid; gap: var(--space-xl); align-items: start; }
  @media (min-width: 60rem) {
    .listen__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--space-2xl); }
    .listen__grid--single { grid-template-columns: minmax(0, 1fr); }
  }
  .listen__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-s); margin-bottom: var(--space-xs); }
  .listen__label { margin: 0; }
  .listen__list > .listen__label { margin-bottom: var(--space-xs); }
  /* Sello: el mismo disco, chico: gira con el hover y con el estado (reposo / reproduciendo) */
  .listen__head :global(.listen__seal) { width: 2.75rem; flex: none; }
  /* Numeración por contador: en móvil el track destacado (ya está en el reproductor) se
     oculta y la lista sigue contando 01, 02, 03 sin saltos */
  .tracks { counter-reset: t; }
  .track { counter-increment: t; border-bottom: var(--divider); }
  .track__n::before { content: counter(t, decimal-leading-zero); }
  .track:first-child { border-top: var(--divider); }
  .track__link {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: var(--space-xs);
    padding-block: var(--space-m);
    min-height: var(--tap);
    transition: padding-left var(--dur-base) var(--ease-out), color var(--dur-fast) var(--ease), background-color var(--dur-base) var(--ease);
  }
  .track__n { color: var(--subtle); transition: color var(--dur-fast) var(--ease); }
  .track__title { font-size: var(--step-1); font-stretch: var(--stretch-title); font-weight: 600; line-height: 1.2; overflow-wrap: anywhere; color: var(--chrome-100); }
  .track__kind { font-size: var(--step-ui); font-weight: var(--font-ui-weight); }
  .track__arrow { color: var(--chrome-500); transition: transform var(--dur-base) var(--ease-out), color var(--dur-fast) var(--ease); }
  .track__link:focus-visible { padding-left: var(--space-xs); background: linear-gradient(90deg, color-mix(in srgb, var(--chrome-300) 8%, transparent), transparent 70%); }
  .track__link:focus-visible .track__n { color: var(--accent); }
  .track__link:focus-visible .track__arrow { color: var(--chrome-50); transform: translate(2px, -2px); }
  @media (hover: hover) {
    .track__link:hover { padding-left: var(--space-xs); background: linear-gradient(90deg, color-mix(in srgb, var(--chrome-300) 8%, transparent), transparent 70%); }
    .track__link:hover .track__n { color: var(--accent); }
    .track__link:hover .track__arrow { color: var(--chrome-50); transform: translate(2px, -2px); }
  }
  .listen__all { margin-top: var(--space-l); display: flex; flex-wrap: wrap; gap: var(--space-xs); }

  /* ==== Móvil ============================================================== */
  @media (max-width: 52rem) {
    .track--featured { display: none; }
    .listen__marquee { margin-bottom: var(--space-l); }
    .listen__grid { gap: var(--space-l); }
    .listen__list > .listen__label { margin-bottom: var(--space-2xs); }
    .track__link {
      grid-template-columns: 2.25rem minmax(0, 1fr) 1.25rem;
      align-items: center;
      padding-block: var(--space-s);
      min-height: 4.25rem;
      transition: background-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease-out);
    }
    .track__arrow { color: var(--chrome-300); }
    .listen__all { margin-top: var(--space-m); }
    .listen__all { display: grid; gap: var(--space-2xs); }
    .listen__all .btn { width: 100%; min-height: 3.25rem; }
  }
  @media (hover: none) {
    .track__link:active {
      background: var(--press-bg);
      transform: scale(var(--press-scale-row));
      transition-duration: var(--dur-press);
    }
    .track__link:active .track__n { color: var(--accent); }
    .track__link:active .track__arrow { color: var(--chrome-50); }
  }
</style>
