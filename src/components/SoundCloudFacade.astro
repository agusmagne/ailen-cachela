---
import { t, type Lang } from '../lib/content';
import Zoetrope from './Zoetrope.astro';

interface Props { title: string; url: string; lang: Lang }
const { title, url, lang } = Astro.props;
// El iframe NO existe hasta el clic (ver scripts/motion.ts). Sin JS, el link abre SoundCloud.
const embed = `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&auto_play=true&hide_related=true&show_comments=false&show_user=true&visual=true`;
---

<div class="player">
  <!-- El escenario conserva el alto cuando el iframe reemplaza a la fachada (en móvil el alto es fijo: sin salto de layout) -->
  <div class="player__stage" data-stage>
  <a class="facade" href={url} data-facade data-embed={embed} data-title={`${title} (SoundCloud)`} target="_blank" rel="noopener noreferrer">
    <span class="facade__disc"><Zoetrope /></span>
    <span class="facade__hub" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </span>
    <span class="facade__text">
      <span class="facade__title" aria-hidden="true">{title}</span>
      <span class="label facade__cta">{t('listen_play', lang)}<span class="sr-only">: {title}, SoundCloud {t('new_tab', lang)}</span></span>
    </span>
  </a>
  </div>
  <p class="player__note">
    <span class="label">{t('listen_privacy', lang)}</span>
    <a class="link" href={url} target="_blank" rel="noopener noreferrer">{t('listen_fallback', lang)}<span class="sr-only"> {t('new_tab', lang)}</span></a>
  </p>
</div>

<style>
  .player { container-type: inline-size; }
  .facade {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: var(--space-m);
    align-content: end;
    min-height: 26rem;
    padding: var(--space-m);
    border: var(--stroke) solid var(--chrome-600);
    border-radius: var(--radius-card);
    background:
      radial-gradient(90% 70% at 85% 0%, color-mix(in srgb, var(--chrome-300) 16%, transparent), transparent 62%),
      radial-gradient(60% 50% at 0% 100%, color-mix(in srgb, var(--chrome-500) 14%, transparent), transparent 70%),
      var(--bg-raised);
    transition: border-color var(--dur-base) var(--ease);
  }
  .facade:focus-visible { border-color: var(--chrome-300); }
  @media (hover: hover) { .facade:hover { border-color: var(--chrome-300); } }
  /* Esquinas de registro, como una portada impresa */
  .facade::before, .facade::after {
    content: '';
    position: absolute;
    width: 0.8rem;
    height: 0.8rem;
    border: var(--stroke) solid var(--chrome-400);
    z-index: 2;
    pointer-events: none;
  }
  .facade::before { top: 0.6rem; left: 0.6rem; border-right: 0; border-bottom: 0; }
  .facade::after { bottom: 0.6rem; right: 0.6rem; border-left: 0; border-top: 0; }

  .facade__disc {
    position: absolute;
    z-index: -1;
    top: 7%;
    left: 50%;
    width: 17.5rem;
    margin-left: -8.75rem;
    width: min(72cqi, 17.5rem);
    margin-left: calc(min(72cqi, 17.5rem) / -2);
  }
  .facade__hub {
    position: absolute;
    z-index: 1;
    top: calc(7% + 8.75rem);
    top: calc(7% + min(72cqi, 17.5rem) / 2);
    left: 50%;
    display: grid;
    place-items: center;
    width: 4.4rem;
    height: 4.4rem;
    margin: -2.2rem 0 0 -2.2rem;
    border-radius: var(--radius-round);
    color: var(--bg);
    background: linear-gradient(145deg, var(--chrome-50), var(--chrome-300) 55%, var(--chrome-100));
    box-shadow: 0 0 0 0.35rem color-mix(in srgb, var(--bg) 70%, transparent), 0 0 0 calc(0.35rem + 1px) var(--chrome-500);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease);
  }
  .facade__hub svg { margin-left: 0.18rem; }
  .facade:focus-visible .facade__hub {
    transform: scale(1.08);
    box-shadow: 0 0 0 0.35rem color-mix(in srgb, var(--bg) 70%, transparent), 0 0 0 calc(0.35rem + 1px) var(--accent);
  }
  @media (hover: hover) {
    .facade:hover .facade__hub {
      transform: scale(1.08);
      box-shadow: 0 0 0 0.35rem color-mix(in srgb, var(--bg) 70%, transparent), 0 0 0 calc(0.35rem + 1px) var(--accent);
    }
  }
  .facade:active .facade__hub { transform: scale(0.97); }

  .facade__text { display: grid; gap: var(--space-xs); padding-top: 17.5rem; padding-top: min(72cqi, 17.5rem); margin-top: var(--space-l); }
  .facade__title {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-stretch: var(--stretch-title);
    font-size: clamp(1.05rem, 1.05rem + 0.8cqi, 1.6rem);
    line-height: var(--lh-title);
    letter-spacing: var(--tracking-title);
    text-transform: var(--case-display);
    overflow-wrap: break-word;
    color: var(--chrome-50);
  }
  .facade__cta { color: var(--chrome-100); }

  .player__note {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    align-items: center;
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--muted);
  }
  :global(.facade__frame) {
    width: 100%;
    height: 18.75rem;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--bg-raised);
    outline: var(--stroke) solid var(--chrome-600);
  }

  /* Contenedor ancho: disco a la izquierda, texto a la derecha */
  @media (min-width: 52.01rem) {
    @container (min-width: 34rem) {
      .facade__disc { top: 50%; left: var(--space-m); margin: 0; transform: translateY(-50%); width: min(44cqi, 17.5rem); }
      .facade__hub { top: 50%; left: calc(var(--space-m) + min(44cqi, 17.5rem) / 2); margin-top: -2.2rem; }
      .facade__text { padding: 0 0 0 calc(min(44cqi, 17.5rem) + var(--space-m)); margin: 0; align-self: center; }
      .facade { align-content: center; min-height: 22rem; }
    }
  }

  /* ==== Móvil: reproductor compacto de alto fijo (fachada = iframe) ==========
     Alto = 240 px: el mínimo en que el reproductor visual de SoundCloud (oscuro, con la
     portada en gris) muestra la onda; el compacto de 166 px es blanco y desentona.
     Disco a la izquierda, título y "Reproducir" a la derecha. El disco acepta
     arrastre horizontal (motion.ts) y deja pasar el scroll vertical. */
  @media (max-width: 52rem) {
    .player { --disc: min(9rem, 31vw); --player-h: 15rem; /* 240 px: el alto mínimo en que el reproductor visual de SoundCloud muestra la onda */ }
    .player__stage { height: var(--player-h); }
    .facade {
      height: 100%;
      min-height: 0;
      grid-template-columns: var(--disc) minmax(0, 1fr);
      align-items: center;
      align-content: center;
      gap: var(--space-s);
      padding: var(--space-xs) var(--space-s);
      touch-action: pan-y pinch-zoom;
    }
    .facade__disc { position: relative; z-index: 0; top: auto; left: auto; margin: 0; width: var(--disc); transform: none; }
    .facade__hub {
      top: 50%;
      left: calc(var(--space-s) + var(--disc) / 2);
      width: 3.5rem;
      height: 3.5rem;
      margin: -1.75rem 0 0 -1.75rem;
    }
    .facade__hub svg { width: 18px; height: 18px; margin-left: 0.14rem; }
    .facade__text { padding: 0; margin: 0; gap: var(--space-2xs); align-self: center; }
    .facade__title {
      font-size: clamp(0.9rem, 4.4vw, 1.1rem);
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .facade:active { border-color: var(--chrome-300); }
    .facade:active .facade__hub { transform: scale(0.94); box-shadow: 0 0 0 0.35rem color-mix(in srgb, var(--bg) 70%, transparent), 0 0 0 calc(0.35rem + 1px) var(--accent); }
    :global(.facade__frame) { height: 100%; }
    .player__note { margin-top: var(--space-2xs); }
    /* Zona táctil de 44 px sin mover el subrayado ni el layout */
    .player__note .link { display: inline-block; padding-block: 0.7rem; margin-block: -0.7rem; background-origin: content-box; }
  }

  /* Zona táctil de 44 px del link de respaldo en cualquier pantalla táctil */
  @media (pointer: coarse) and (min-width: 52.01rem) {
    .player__note .link { display: inline-block; padding-block: 0.7rem; margin-block: -0.7rem; background-origin: content-box; }
  }
  /* Teléfono en horizontal: la fachada no puede ser más alta que la pantalla (352 px en 390) */
  @media (pointer: coarse) and (max-height: 32rem) {
    .player__stage { height: 15rem; }
    .facade { height: 100%; min-height: 0; }
    :global(.facade__frame) { height: 100%; }
    .facade__disc { width: 11rem; }
    .facade__hub { left: calc(var(--space-m) + 5.5rem); }
    .facade__text { padding-left: calc(11rem + var(--space-m)); }
  }
</style>
