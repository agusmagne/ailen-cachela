---
/**
 * Opción de formulario (radio o casilla) con el aspecto del sitio: cuadrado de cromo, área táctil de 44 px.
 * El <input> real queda visible para teclado y lectores de pantalla; solo se redibuja su marca.
 */
interface Props {
  type: 'radio' | 'checkbox';
  name: string;
  value: string;
  label: string;
  checked?: boolean;
  class?: string;
  [attr: string]: unknown;
}
const { type, name, value, label, checked = false, class: cls, ...rest } = Astro.props;
---

<label class:list={['choice', cls]}>
  <input class="choice__input" type={type} name={name} value={value} checked={checked} {...rest} />
  <span class="choice__mark" aria-hidden="true"></span>
  <span class="choice__label">{label}</span>
</label>

<style>
  .choice { position: relative; display: inline-flex; align-items: center; gap: var(--space-xs); min-height: var(--tap); padding-right: var(--space-s); cursor: pointer; color: var(--chrome-100); }
  .choice__input { position: absolute; inset: 0 auto 0 0; width: var(--tap); height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .choice__mark { position: relative; flex: none; width: 1.35rem; height: 1.35rem; border: var(--stroke) solid var(--chrome-400); background: var(--bg-raised); transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease); }
  .choice__input[type='radio'] + .choice__mark { border-radius: var(--radius-round); }
  .choice__mark::after { content: ''; position: absolute; inset: 0.28rem; background: var(--chrome-50); transform: scale(0); transition: transform var(--dur-fast) var(--ease-out); }
  .choice__input[type='radio'] + .choice__mark::after { border-radius: var(--radius-round); }
  .choice__input:checked + .choice__mark { border-color: var(--chrome-50); }
  .choice__input:checked + .choice__mark::after { transform: scale(1); }
  .choice__input:focus-visible + .choice__mark { outline: 2px solid var(--focus); outline-offset: 3px; }
  @media (hover: hover) { .choice:hover .choice__mark { border-color: var(--chrome-200); } }
  .choice__label { font-size: var(--step-0); }
  @media (prefers-contrast: more) { .choice__mark { border-color: var(--chrome-50); } }
</style>
