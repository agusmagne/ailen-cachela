---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHead from '../ui/SectionHead.astro';
import Chip from '../ui/Chip.astro';
import DataList from '../ui/DataList.astro';
import DataTable from '../ui/DataTable.astro';
import LazyModule from '../ui/LazyModule.astro';
import { site, t, pick, formatDate, withBase, type Lang } from '../../lib/content';
import { router } from '../../lib/routes';
import { domain } from '../../lib/data';
import { schema } from '../../lib/schemas/legal.ts';
import { FONTS, TECH, OFL_URL, packageInfo } from '../../lib/fans/credits.ts';

/**
 * Página legal genérica (privacidad, accesibilidad, aviso legal, créditos): el texto vive en src/content/legal.yaml
 * (docs.<doc>), los datos de la titular son campos a completar y los créditos leen versión y licencia de node_modules.
 */
interface Props {
  lang: Lang;
  /** id de la ruta del registro */
  route: string;
  /** clave en legal.yaml → docs */
  doc: string;
  descriptionKey: string;
}
const { lang, route, doc: docId, descriptionKey } = Astro.props;
const legal = domain('legal', schema);
const d = legal.docs[docId];
if (!d) throw new Error(`legal.yaml: falta docs.${docId}`);
const fill = (s: string) => s.replace(/\{email\}/g, site.contact.email);
const showTocFrom = 4;
const toc = d.sections.length >= showTocFrom ? d.sections.map((s) => ({ id: s.id, title: pick(s.title, lang) })) : [];
const holder = legal.items.map((f) => ({ label: pick(f.label, lang), hint: pick(f.hint, lang), value: f.value }));
const techRows = TECH.map((x) => {
  const info = packageInfo(x.pkg);
  return { name: { text: info.name, href: info.homepage || undefined, external: !!info.homepage }, role: t(`fans_tech_role_${x.role}`, lang), version: info.version, license: info.license };
});
const fonts = FONTS.map((f) => ({ ...f, info: packageInfo(f.pkg) }));
const missing = t('fans_holder_missing', lang);
---

<PageLayout lang={lang} route={route} title={pick(d.title, lang)} description={t(descriptionKey, lang)}>
  <p slot="lead">{pick(d.lead, lang)}</p>
  <p slot="meta" class="label legal__meta">
    <time datetime={d.updated}>{t('fans_legal_updated', lang, { date: formatDate(d.updated, lang, { dateStyle: 'long' }) })}</time>
  </p>

  <div class="legal">
    {
      toc.length > 0 && (
        <nav class="legal__toc" aria-label={t('fans_legal_toc', lang)}>
          <p class="label">{t('fans_legal_toc', lang)}</p>
          <ol>
            {toc.map((s) => <li><a class="link" href={`#${s.id}`}>{s.title}</a></li>)}
          </ol>
        </nav>
      )
    }

    <div class="legal__body">
      {
        d.sections.map((s) => {
          const target = s.link && router.listed(s.link.route) ? { href: router.path(s.link.route, lang), label: pick(s.link.label, lang) } : null;
          return (
            <section class="legal__section" aria-labelledby={s.id}>
              <SectionHead lang={lang} id={s.id} title={pick(s.title, lang)} level="h2" />
              {s.paras[lang].length > 0 && <div class="prose">{s.paras[lang].map((p) => <p>{fill(p)}</p>)}</div>}
              {s.bullets[lang].length > 0 && <ul class="prose legal__bullets">{s.bullets[lang].map((b) => <li>{fill(b)}</li>)}</ul>}
              {
                s.checks.length > 0 && (
                  <ul class="checks">
                    {
                      s.checks.map((c) => (
                        <li class="checks__item">
                          <div class="checks__head">
                            <h3 class="checks__area display">{pick(c.area, lang)}</h3>
                            <Chip tone={c.status === 'done' ? 'accent' : 'default'}>{t(`fans_status_${c.status}`, lang)}</Chip>
                          </div>
                          <p>{fill(pick(c.text, lang))}</p>
                        </li>
                      ))
                    }
                  </ul>
                )
              }
              {
                s.widget === 'holder' && (
                  <div class="legal__holder">
                    <p class="label">{t('fans_holder_title', lang)}</p>
                    <dl class="holder">
                      {
                        holder.map((f) => (
                          <div class="holder__row">
                            <dt class="label">{f.label}</dt>
                            <dd>{f.value ? f.value : <><Chip tone="accent">{missing}</Chip> <span class="holder__hint">{f.hint}</span></>}</dd>
                          </div>
                        ))
                      }
                    </dl>
                  </div>
                )
              }
              {
                s.widget === 'fonts' && (
                  <ul class="fonts">
                    {
                      fonts.map((f) => (
                        <li class="fonts__item">
                          <p class="fonts__specimen display" aria-hidden="true" data-font={f.id}>Aa</p>
                          <div class="fonts__text">
                            <h3 class="fonts__name display">{f.family}</h3>
                            <p class="label">{t(`fans_fonts_role_${f.role}`, lang)}</p>
                            <DataList
                              layout="rows"
                              items={[
                                { label: t('fans_fonts_license', lang), value: f.license, href: OFL_URL, external: true },
                                { label: t('fans_fonts_source', lang), value: f.source.replace('https://', ''), href: f.source, external: true },
                                { label: t('fans_fonts_package', lang), value: `${f.pkg} ${f.info.version}` },
                              ]}
                            />
                          </div>
                        </li>
                      ))
                    }
                  </ul>
                )
              }
              {s.widget === 'tech' && <DataTable lang={lang} caption={t('fans_tech_caption', lang)} columns={[{ key: 'name', label: t('fans_tech_col_name', lang) }, { key: 'role', label: t('fans_tech_col_role', lang) }, { key: 'version', label: t('fans_tech_col_version', lang), nowrap: true }, { key: 'license', label: t('fans_tech_col_license', lang), nowrap: true }]} rows={techRows} />}
              {
                s.widget === 'offline' && (
                  <LazyModule name="fans-pwa-panel" when="idle" class="sw" props={{ base: withBase('') }}>
                    <div class="sw__panel" data-sw-panel hidden>
                      <p class="label">{t('fans_sw_title', lang)}</p>
                      <p class="sw__state" data-sw-state data-msg-on={t('fans_sw_on', lang)} data-msg-off={t('fans_sw_off', lang)} data-msg-none={t('fans_sw_none', lang)} role="status"></p>
                      <button type="button" class="btn" data-sw-toggle data-label-disable={t('fans_sw_disable', lang)} data-label-enable={t('fans_sw_enable', lang)} data-done-off={t('fans_sw_done_off', lang)} data-done-on={t('fans_sw_done_on', lang)} hidden></button>
                    </div>
                  </LazyModule>
                )
              }
              {s.note && pick(s.note, lang) && <p class="legal__note">{pick(s.note, lang)}</p>}
              {target && <p class="legal__more"><span class="label">{t('fans_legal_see_also', lang)}</span> <a class="link" href={target.href}>{target.label}</a></p>}
            </section>
          );
        })
      }
    </div>

    <p class="legal__disclaimer label">{t('fans_legal_disclaimer', lang)}</p>
  </div>
</PageLayout>

<style>
  /* Zonas táctiles de 44 px en los enlaces de las listas (créditos, índice, titular) sin mover el texto */
  @media (max-width: 52rem), (pointer: coarse) {
    .legal :global(li > a.link), .legal :global(.legal__holder a.link), .legal :global(p > a.link:only-child) { display: inline-block; padding-block: 0.7rem; margin-block: -0.7rem; background-origin: content-box; }
  }
  .legal__meta { color: var(--subtle); }
  .legal { display: grid; gap: var(--space-xl); }
  .legal__toc { display: grid; gap: var(--space-2xs); max-width: var(--measure); padding: var(--space-s) var(--space-m); border: var(--card-border); background: var(--card-bg); }
  .legal__toc ol { counter-reset: toc; display: grid; gap: 0; }
  .legal__toc li { counter-increment: toc; }
  .legal__toc li::before { content: counter(toc, decimal-leading-zero); margin-right: var(--space-xs); font-family: var(--font-ui); font-size: var(--step-ui); color: var(--accent); }
  .legal__toc .link { display: inline-flex; align-items: center; min-height: var(--tap); }
  .legal__body { display: grid; gap: var(--space-2xl); }
  .legal__section { display: grid; gap: var(--space-s); align-content: start; }
  .legal__section :global(.sh) { margin-bottom: var(--space-s); }
  .legal__bullets { max-width: var(--measure); }
  .legal__note { max-width: var(--measure); color: var(--muted); }
  .legal__more { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-xs); }
  .legal__more .link { color: var(--chrome-50); }
  .legal__disclaimer { padding-top: var(--space-m); border-top: var(--divider); max-width: var(--measure); }
  .checks { display: grid; gap: 0; border-top: var(--divider); max-width: 52rem; }
  .checks__item { display: grid; gap: var(--space-2xs); padding-block: var(--space-s); border-bottom: var(--divider); color: var(--chrome-200); }
  .checks__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2xs) var(--space-s); }
  .checks__area { font-size: var(--step-1); color: var(--chrome-50); }
  .holder { display: grid; max-width: 40rem; border-top: var(--divider); }
  .holder__row { display: grid; grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr); align-items: baseline; gap: var(--space-xs); padding-block: var(--space-xs); border-bottom: var(--divider); }
  .holder dd { margin: 0; color: var(--chrome-100); overflow-wrap: anywhere; }
  .holder__hint { font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 40rem) { .holder__row { grid-template-columns: 1fr; gap: var(--space-3xs); } }
  .fonts { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .fonts__item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-m); padding: var(--card-pad); border: var(--card-border); background: var(--card-bg); align-items: start; }
  .fonts__specimen { font-size: clamp(3rem, 2rem + 5vw, 5.5rem); line-height: 0.9; color: var(--chrome-50); }
  .fonts__specimen[data-font='martian'] { font-family: var(--font-ui); font-weight: var(--font-ui-weight); text-transform: none; font-stretch: 100%; }
  .fonts__text { display: grid; gap: var(--space-2xs); min-width: 0; }
  .fonts__name { font-size: var(--step-1); color: var(--chrome-50); }
  @media (max-width: 30rem) { .fonts__item { grid-template-columns: 1fr; } }
  .sw__panel { display: grid; gap: var(--space-xs); justify-items: start; max-width: var(--measure); padding: var(--space-s) var(--space-m); border: var(--card-border); background: var(--card-bg); }
  .sw__panel[hidden], .sw__panel [hidden] { display: none; }
  .sw__state { color: var(--chrome-200); }
</style>
