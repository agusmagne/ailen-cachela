---
import Glitch from '../Glitch.astro';
import DemoBadge from './DemoBadge.astro';
import type { Lang } from '../../lib/content';
/**
 * Encabezado de una sección DENTRO de una página (h2). Filete de cromo arriba, etiqueta opcional, título
 * y bajada. `demo` agrega la marca de sección ("contenido de ejemplo" + nota). `id` crea el ancla.
 */
interface Props {
  id?: string;
  title: string;
  kicker?: string;
  lead?: string;
  lang: Lang;
  demo?: boolean;
  level?: 'h2' | 'h3';
}
const { id, title, kicker, lead, lang, demo = false, level: H = 'h2' } = Astro.props;
---

<header class="sh" data-glitch-host>
  <div class="sh__edge" data-reveal="line" aria-hidden="true"></div>
  {kicker && <p class="label sh__kicker">{kicker}</p>}
  <H class="sh__title display" id={id}><Glitch text={title} block>{title}</Glitch></H>
  {lead && <p class="sh__lead">{lead}</p>}
  {demo && <DemoBadge lang={lang} variant="section" />}
</header>

<style>
  .sh { display: grid; gap: var(--space-xs); margin-bottom: var(--space-l); justify-items: start; }
  .sh__edge { width: 100%; height: var(--stroke); margin-bottom: var(--space-s); background: linear-gradient(90deg, var(--chrome-600), var(--chrome-300) 18%, var(--chrome-600) 58%, transparent); }
  .sh__kicker { color: var(--accent); }
  .sh__title { font-size: var(--step-3); line-height: var(--lh-title); overflow-wrap: anywhere; scroll-margin-top: var(--header-h); }
  .sh__lead { max-width: var(--measure); font-size: var(--step-1); color: var(--chrome-200); }
</style>
