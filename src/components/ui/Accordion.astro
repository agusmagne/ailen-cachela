---
/**
 * Acordeón con <details>/<summary> nativos: teclado, lectores de pantalla y sin JS gratis. Cada panel llega
 * por un slot con el mismo nombre que su `id`. `exclusive` abre de a uno (atributo name; donde no se soporta,
 * simplemente se pueden abrir varios).
 *   <Accordion items={[{ id:'cancel', title:'Cancelaciones' }]}> <p slot="cancel">...</p> </Accordion>
 */
interface Props {
  items: { id: string; title: string; open?: boolean }[];
  exclusive?: boolean;
  class?: string;
}
const { items, exclusive = false, class: cls } = Astro.props;
const group = `acc-${Math.abs([...items.map((i) => i.id).join('|')].reduce((h, c) => (Math.imul(h, 31) + c.charCodeAt(0)) | 0, 11))}`;
const bodies = await Promise.all(items.map(async (it) => ({ ...it, html: await Astro.slots.render(it.id) })));
---

<div class:list={['acc', cls]}>
  {
    bodies.map((it) => (
      <details class="acc__item" open={it.open} {...(exclusive ? { name: group } : {})}>
        <summary class="acc__summary"><span>{it.title}</span><span class="acc__icon" aria-hidden="true"></span></summary>
        <div class="acc__body prose"><Fragment set:html={it.html} /></div>
      </details>
    ))
  }
</div>

<style>
  .acc { border-top: var(--divider); }
  .acc__item { border-bottom: var(--divider); }
  .acc__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: var(--tap-lg);
    padding-block: var(--space-2xs);
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: var(--stretch-title);
    font-size: var(--step-1);
    color: var(--chrome-100);
    cursor: pointer;
  }
  .acc__summary::-webkit-details-marker { display: none; }
  .acc__summary:focus-visible { outline-offset: -2px; }
  @media (hover: hover) { .acc__summary:hover { color: var(--chrome-50); } }
  .acc__summary:active { background: var(--press-bg); }
  /* Más / menos dibujado con dos trazos */
  .acc__icon { position: relative; flex: none; width: 1rem; height: 1rem; }
  .acc__icon::before, .acc__icon::after { content: ''; position: absolute; inset: 50% 0 auto 0; height: var(--stroke); background: currentColor; transition: transform var(--dur-base) var(--ease-out); }
  .acc__icon::after { transform: rotate(90deg); }
  .acc__item[open] .acc__icon::after { transform: rotate(0deg); }
  .acc__body { padding-bottom: var(--space-m); }
</style>
