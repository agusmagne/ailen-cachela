---
import { t, type Lang } from '../../lib/content';
/** Estado vacío digno: una página o sección cuyo contenido (real) todavía no existe. */
interface Props {
  lang: Lang;
  title?: string;
  text?: string;
}
const { lang, title = t('base_empty_title', lang), text = t('base_empty_text', lang) } = Astro.props;
---

<div class="empty" role="status">
  <p class="label empty__kicker" aria-hidden="true">∅</p>
  <h2 class="empty__title display">{title}</h2>
  <p class="empty__text">{text}</p>
  <div class="empty__action"><slot /></div>
</div>

<style>
  .empty {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    padding: var(--space-xl) var(--space-m);
    border: var(--card-border);
    background-image: var(--halftone);
    background-size: calc(var(--halftone-size) * 2) calc(var(--halftone-size) * 2);
    background-color: var(--bg-raised);
  }
  .empty__kicker { color: var(--accent); font-size: var(--step-2); line-height: 1; }
  .empty__title { font-size: var(--step-2); background: var(--bg-raised); padding-right: var(--space-2xs); }
  .empty__text { max-width: var(--measure); color: var(--muted); background: var(--bg-raised); }
  .empty__action:empty { display: none; }
</style>
