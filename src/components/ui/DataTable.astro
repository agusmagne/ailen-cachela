---
import { t, type Lang } from '../../lib/content';
/**
 * Tabla responsiva y accesible. En escritorio, tabla con scroll horizontal enfocable si no entra; en teléfono
 * (<= 40 rem) cada fila pasa a bloque "etiqueta: valor" (las celdas llevan data-label).
 *   <DataTable lang caption="Fechas 2025" columns={[{ key:'date', label:'Fecha' }, ...]} rows={[{ date:'12/04', venue:{ text:'Club', href:'...' } }]} />
 * Una celda es texto/número o { text, href, external }. `numeric` alinea a la derecha con cifras tabulares.
 */
export interface Column {
  key: string;
  label: string;
  numeric?: boolean;
  nowrap?: boolean;
}
type Cell = string | number | { text: string | number; href?: string; external?: boolean };
interface Props {
  lang: Lang;
  caption: string;
  columns: Column[];
  rows: Record<string, Cell>[];
  /** Muestra el caption en pantalla (por defecto solo para lectores de pantalla). */
  showCaption?: boolean;
}
const { lang, caption, columns, rows, showCaption = false } = Astro.props;
const cell = (c: Cell | undefined) => (typeof c === 'object' && c !== null ? c : { text: c ?? '' });
---

<div class="tbl" role="region" aria-label={`${caption}. ${t('base_table_scroll', lang)}`} tabindex="0">
  <table>
    <caption class:list={{ 'sr-only': !showCaption, label: showCaption }}>{caption}</caption>
    <thead>
      <tr>{columns.map((c) => <th scope="col" class:list={{ num: c.numeric }}>{c.label}</th>)}</tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            {columns.map((c) => {
              const v = cell(r[c.key]);
              return (
                <td data-label={c.label} class:list={{ num: c.numeric, nowrap: c.nowrap }}>
                  {v.href ? <a class="link" href={v.href} {...(v.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{v.text}</a> : v.text}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .tbl { overflow-x: auto; border: var(--card-border); overscroll-behavior-x: contain; }
  .tbl:focus-visible { outline-offset: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  caption { text-align: left; padding: var(--space-xs) var(--space-s); }
  th { position: sticky; top: 0; text-align: left; padding: var(--space-xs) var(--space-s); font-family: var(--font-ui); font-weight: var(--font-ui-weight); font-size: var(--step-ui); letter-spacing: var(--tracking-ui); text-transform: var(--case-ui); color: var(--muted); background: var(--table-head-bg); border-bottom: var(--divider); white-space: nowrap; }
  td { padding: var(--space-xs) var(--space-s); border-bottom: var(--table-row-line); vertical-align: top; color: var(--chrome-100); }
  tbody tr:last-child td { border-bottom: 0; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .nowrap { white-space: nowrap; }
  @media (hover: hover) { tbody tr:hover td { background: var(--press-bg); } }
  @media (max-width: 40rem) {
    .tbl { overflow: visible; border: 0; }
    table, tbody, tr, td { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tr { border: var(--card-border); margin-bottom: var(--space-xs); padding: var(--space-2xs) 0; background: var(--bg-raised); }
    td { display: grid; grid-template-columns: minmax(6rem, 8rem) minmax(0, 1fr); gap: var(--space-xs); border: 0; padding: var(--space-3xs) var(--space-s); text-align: left; }
    td::before { content: attr(data-label); font-family: var(--font-ui); font-size: var(--step-ui); letter-spacing: var(--tracking-ui); text-transform: var(--case-ui); color: var(--muted); }
    .num { text-align: left; }
  }
</style>
