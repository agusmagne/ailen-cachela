---
import { site, t, type Lang } from '../lib/content';
import { router } from '../lib/routes';
import Section from './Section.astro';
import Glitch from './Glitch.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const networks = site.links.filter((l) => l.contact && l.url);
const rings = Array.from({ length: 14 }, (_, i) => 8 + i * 6);
---

<Section id="contacto" title={t('contact_title', lang)}>
  <!-- Cierre calmo: aros concéntricos estáticos (SVG), sin movimiento -->
  <svg class="rings" viewBox="-100 -100 200 200" aria-hidden="true" focusable="false">
    {rings.map((r) => <circle r={r} />)}
  </svg>
  <div class="contact">
    <div class="contact__main" data-reveal>
      <p class="contact__lead">{t('contact_lead', lang)}</p>
      <!-- Móvil: un único blanco grande (email de ancho completo) + copiar al costado -->
      <div class="contact__cta">
        <a class="contact__mail" href={`mailto:${site.contact.email}`} data-glitch-host>
          <span class="contact__write label" aria-hidden="true">{t('contact_write', lang)} <span class="arrow" aria-hidden="true">↗</span></span>
          <Glitch text={site.contact.email}><span class="contact__text link">{site.contact.email}</span></Glitch>
        </a>
        <div class="contact__actions">
          <button
            type="button"
            class="btn contact__copy"
            data-copy={site.contact.email}
            data-done={t('contact_copied', lang)}
            ><span class="copy__icon" aria-hidden="true"></span><span class="copy__label" data-copy-label>{t('contact_copy', lang)}</span></button
          >
          <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
        </div>
      </div>
      {
        router.listed('booking') && (
          <p class="contact__booking">
            <a class="btn btn--primary" href={router.path('booking', lang)}>
              {t('home_contact_booking', lang)} <span class="arrow" data-dir="right" aria-hidden="true">→</span>
            </a>
          </p>
        )
      }
    </div>
    {
      networks.length > 0 && (
        <div class="contact__nets" data-reveal style="--reveal-delay:120ms">
          <h3 class="label">{t('contact_networks', lang)}</h3>
          <ul class="nets">
            {networks.map((l) => (
              <li>
                <a class="net" href={l.url} target="_blank" rel="noopener noreferrer">
                  <span class="net__platform label">{l.label ? `${l.platform} · ${l.label}` : l.platform}</span>
                  <span class="net__handle">{l.handle}</span>
                  <span class="arrow net__arrow" aria-hidden="true">↗</span>
                  <span class="sr-only">{t('new_tab', lang)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</Section>

<style>
  :global(#contacto) { overflow: hidden; isolation: isolate; }
  .rings {
    position: absolute;
    z-index: -1;
    right: -18%;
    top: 50%;
    width: min(60rem, 120vw);
    transform: translateY(-50%);
    opacity: 0.5;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(closest-side, #000 20%, transparent);
    mask-image: radial-gradient(closest-side, #000 20%, transparent);
  }
  .rings circle { fill: none; stroke: var(--chrome-500); stroke-width: 0.25; }
  .contact { display: grid; gap: var(--space-xl); }
  @media (min-width: 60rem) { .contact { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--space-2xl); } }
  .contact__lead { color: var(--muted); max-width: 32ch; margin-bottom: var(--space-s); }
  .contact__mail {
    display: inline-block;
    max-width: 100%;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: var(--stretch-title);
    font-size: clamp(1.05rem, 5.4vw, 2.05rem);
    line-height: 1.1;
    letter-spacing: var(--tracking-title);
    overflow-wrap: anywhere;
    color: var(--chrome-50);
  }
  .contact__actions { margin-top: var(--space-m); }
  .contact__booking { margin-top: var(--space-m); }
  .contact__write, .copy__icon { display: none; }
  /* El botón de copiar solo existe con JS */
  .contact__copy { display: none; }
  :global(.js) .contact__copy { display: inline-flex; }
  .contact__nets > h3 { margin-bottom: var(--space-xs); }
  .net {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-s);
    align-items: baseline;
    padding-block: var(--space-m);
    border-bottom: var(--divider);
    min-height: var(--tap);
    transition: padding-left var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease);
  }
  .nets li:first-child .net { border-top: var(--divider); }
  .net__platform { grid-column: 1; transition: color var(--dur-fast) var(--ease); }
  .net__handle { grid-column: 1; font-size: var(--step-1); overflow-wrap: anywhere; color: var(--chrome-100); }
  .net__arrow { grid-column: 2; grid-row: 1 / span 2; align-self: center; color: var(--chrome-500); transition: transform var(--dur-base) var(--ease-out), color var(--dur-fast) var(--ease); }
  .net:focus-visible { padding-left: var(--space-xs); background: linear-gradient(90deg, color-mix(in srgb, var(--chrome-300) 8%, transparent), transparent 70%); }
  .net:focus-visible .net__platform { color: var(--accent); }
  .net:focus-visible .net__arrow { transform: translate(2px, -2px); color: var(--chrome-50); }
  @media (hover: hover) {
    .net:hover { padding-left: var(--space-xs); background: linear-gradient(90deg, color-mix(in srgb, var(--chrome-300) 8%, transparent), transparent 70%); }
    .net:hover .net__platform { color: var(--accent); }
    .net:hover .net__arrow { transform: translate(2px, -2px); color: var(--chrome-50); }
  }

  /* ==== Móvil: un único blanco grande ======================================
     El email es un botón de ancho completo (64 px) con "copiar" pegado al costado;
     las redes pasan a una rejilla de dos columnas en lugar de cinco filas altas. */
  @media (max-width: 52rem) {
    .contact { gap: var(--space-l); }
    .contact__lead { margin-bottom: var(--space-s); max-width: 28ch; }
    .contact__booking .btn { width: 100%; min-height: 3.5rem; }
    .contact__cta { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2xs); }
    :global(.js) .contact__cta { grid-template-columns: minmax(0, 1fr) 4rem; }
    .contact__actions { display: contents; }
    .contact__mail {
      display: grid;
      align-content: center;
      gap: 0.15rem;
      grid-column: 1;
      min-height: 4rem;
      padding: var(--space-xs) var(--space-s);
      font-size: clamp(0.9375rem, 4.2vw, 1.0625rem);
      font-stretch: var(--stretch-body);
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1.2;
      color: var(--bg);
      background: linear-gradient(100deg, var(--chrome-200), var(--chrome-50) 45%, var(--chrome-200));
      border: var(--stroke) solid var(--chrome-100);
      transition: transform var(--dur-base) var(--ease-out), filter var(--dur-base) var(--ease);
    }
    .contact__mail:active { transform: scale(var(--press-scale)); filter: brightness(1.12); transition-duration: var(--dur-press); }
    .contact__write { display: flex; align-items: center; gap: 0.4em; color: var(--chrome-600); }
    .contact__write .arrow { margin-left: auto; }
    .contact__text.link { background: none; padding: 0; color: inherit; }
    .contact__mail :global(.glitch) { display: block; }
    .contact__copy {
      grid-column: 2;
      width: 4rem;
      min-height: 4rem;
      padding: 0;
    }
    .copy__icon {
      display: block;
      width: 1.35rem;
      height: 1.35rem;
      background: currentColor;
      -webkit-mask: var(--copy-icon) center / contain no-repeat;
      mask: var(--copy-icon) center / contain no-repeat;
      --copy-icon: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='M5.5 5.5h8v8h-8zM2.5 10.5v-8h8' fill='none' stroke='black' stroke-width='1.4' stroke-linecap='square'/></svg>");
      --check-icon: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='M2.5 8.5 6.5 12.5 13.5 4' fill='none' stroke='black' stroke-width='1.6' stroke-linecap='square'/></svg>");
    }
    .contact__copy.is-done .copy__icon { -webkit-mask-image: var(--check-icon); mask-image: var(--check-icon); }
    .contact__copy.is-done { border-color: var(--accent); }
    .copy__label {
      position: absolute;
      width: 1px; height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .nets { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2xs); }
    .nets li:first-child .net { border-top: var(--stroke) solid var(--chrome-700); }
    .net {
      position: relative;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: var(--space-3xs);
      height: 100%;
      min-height: 5rem;
      padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-s);
      border: var(--stroke) solid var(--chrome-700);
      background: color-mix(in srgb, var(--bg-raised) 70%, transparent);
    }
    .net__platform { padding-right: 1.5rem; }
    .net__handle { font-size: var(--step-0); font-weight: 600; }
    .net__arrow { position: absolute; top: var(--space-xs); right: var(--space-xs); grid-column: auto; grid-row: auto; color: var(--chrome-300); }
    .nets > li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  @media (hover: none) {
    .net { transition: background-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease); }
    .net:active { background: var(--press-bg); border-color: var(--chrome-300); transform: scale(var(--press-scale)); transition-duration: var(--dur-press); }
    .net:active .net__platform { color: var(--accent); }
    .net:active .net__arrow { color: var(--chrome-50); }
  }
  /* Táctil en pantallas anchas (tableta, teléfono en horizontal): el email también mide 44 px de alto */
  @media (pointer: coarse) and (min-width: 52.01rem) {
    .contact__mail { padding-block: 0.4rem; margin-block: -0.4rem; }
  }
</style>
