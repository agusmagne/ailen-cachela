---
/**
 * Disco de fenaquistiscopio dibujado por código: 12 cuadros radiales (un péndulo
 * con bola que respira) y 12 ranuras. Gira a saltos (steps) según el estado:
 *  - reposo: avanza un cuadro por cada tramo de scroll (motion.ts, --zt-rot)
 *  - hover (solo con mouse) o foco de teclado del contenedor [data-zt-scope]: avanza lento
 *  - táctil: arrastre horizontal sobre la fachada = cuadro a cuadro (--zt-drag, motion.ts)
 *  - data-zt-state="live" en el contenedor: gira rápido (reproduciendo)
 * Colores: solo variables de tokens.css.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;
const N = 12;
const C = 100;
const rad = (d: number) => (d * Math.PI) / 180;
const cells = Array.from({ length: N }, (_, i) => {
  const phase = (i / N) * Math.PI * 2;
  const swing = Math.sin(phase) * 28;
  const grow = (1 - Math.cos(phase)) / 2;
  const ax = C;
  const ay = C - 42;
  const len = 30;
  const tx = +(ax + len * Math.sin(rad(swing))).toFixed(2);
  const ty = +(ay - len * Math.cos(rad(swing))).toFixed(2);
  return { a: (i * 360) / N, ax, ay, tx, ty, r: +(2.2 + 4.2 * grow).toFixed(2), first: i === 0 };
});
const dividers = Array.from({ length: N }, (_, i) => (i * 360) / N + 15);
---

<div class:list={['zt', cls]} data-zoetrope aria-hidden="true">
  <svg class="zt__disc" viewBox="0 0 200 200" focusable="false">
    <circle class="zt__plate" cx={C} cy={C} r="97" />
    <circle class="zt__hair" cx={C} cy={C} r="94" />
    <circle class="zt__hair" cx={C} cy={C} r="82" />
    <circle class="zt__dash" cx={C} cy={C} r="30" />
    <circle class="zt__hair" cx={C} cy={C} r="25" />
    <circle class="zt__hair zt__hair--soft" cx={C} cy={C} r="21" />
    <circle class="zt__hair zt__hair--soft" cx={C} cy={C} r="17" />
    {dividers.map((a) => <line class="zt__rule" x1={C} y1={C - 30} x2={C} y2={C - 82} transform={`rotate(${a} ${C} ${C})`} />)}
    {
      cells.map((c) => (
        <g transform={`rotate(${c.a} ${C} ${C})`}>
          <rect class="zt__slit" x={C - 1.8} y={C - 92} width="3.6" height="8" />
          <line class="zt__arm" x1={c.ax} y1={c.ay} x2={c.tx} y2={c.ty} />
          <circle class:list={['zt__ball', { 'zt__ball--first': c.first }]} cx={c.tx} cy={c.ty} r={c.r} />
          <circle class="zt__pivot" cx={c.ax} cy={c.ay} r="1.4" />
        </g>
      ))
    }
  </svg>
</div>

<style>
  .zt {
    width: 100%;
    aspect-ratio: 1;
    transform: rotate(calc(var(--zt-rot, 0deg) + var(--zt-drag, 0deg)));
  }
  .zt__disc { width: 100%; height: 100%; display: block; overflow: visible; }
  .zt__plate { fill: color-mix(in srgb, var(--chrome-800) 80%, transparent); stroke: var(--chrome-400); stroke-width: 0.9; }
  .zt__hair { fill: none; stroke: var(--chrome-500); stroke-width: 0.45; }
  .zt__hair--soft { stroke: var(--chrome-600); }
  .zt__dash { fill: none; stroke: var(--chrome-400); stroke-width: 0.6; stroke-dasharray: 1.2 2.6; }
  .zt__rule { stroke: var(--chrome-600); stroke-width: 0.45; }
  .zt__slit { fill: var(--bg); stroke: var(--chrome-300); stroke-width: 0.55; }
  .zt__arm { stroke: var(--chrome-200); stroke-width: 2.4; stroke-linecap: round; }
  .zt__ball { fill: var(--chrome-50); }
  .zt__ball--first { fill: var(--accent); }
  .zt__pivot { fill: var(--bg); stroke: var(--chrome-300); stroke-width: 0.5; }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-zt-scope]:has(:focus-visible)) .zt__disc {
      animation: zt-step var(--zoetrope-idle) steps(12, end) infinite;
    }
    @media (hover: hover) {
      :global([data-zt-scope]:hover) .zt__disc {
        animation: zt-step var(--zoetrope-idle) steps(12, end) infinite;
      }
    }
    :global([data-zt-state='live']) .zt__disc {
      animation: zt-step var(--zoetrope-live) steps(12, end) infinite;
    }
  }
  @keyframes zt-step {
    to { transform: rotate(360deg); }
  }
</style>
