---
import { site, t, type Lang } from '../lib/content';
import { router } from '../lib/routes';
import { demoOn } from '../lib/demo';
import SiteIndex from './ui/SiteIndex.astro';
import DemoNotice from './ui/DemoNotice.astro';
interface Props {
  lang: Lang;
  /** Id de ruta de la página actual (marca aria-current en el índice). */
  route?: string;
}
const { lang, route } = Astro.props;
const hasIndex = router.index().length > 0;
const year = new Date().getFullYear(); // se genera en build
const links = site.links.filter((l) => l.footer && l.url);
---

<footer class="footer">
  <div class="footer__edge" aria-hidden="true"></div>
  {hasIndex && <div class="wrap footer__index"><SiteIndex lang={lang} variant="footer" current={route} /></div>}
  {demoOn && <div class="wrap footer__demo"><DemoNotice lang={lang} /></div>}
  <div class="wrap footer__inner">
    <p class="footer__rights label">{t('footer_rights', lang, { year, name: site.site.name })}</p>
    <ul class="footer__links">
      {
        links.map((l) => (
          <li>
            <a class="footer__link link" href={l.url} target="_blank" rel="noopener noreferrer">
              {l.id === 'linktree' ? t('footer_backup', lang) + ' · Linktree' : l.platform}
              <span class="sr-only"> {l.handle} {t('new_tab', lang)}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="footer__top link" href="#top">{t('footer_top', lang)} <span class="arrow" data-dir="up" aria-hidden="true">↑</span></a>
  </div>
  <p class="footer__mark" aria-hidden="true">{site.artist.name}</p>
</footer>

<style>
  .footer { position: relative; overflow: hidden; padding-top: var(--space-l); }
  .footer__edge { position: absolute; inset: 0 0 auto 0; height: var(--stroke); background: linear-gradient(90deg, transparent, var(--chrome-600) 20%, var(--chrome-600) 80%, transparent); }
  .footer__index { margin-bottom: var(--space-l); }
  .footer__demo { margin-bottom: var(--space-s); }
  .footer__inner { display: flex; flex-wrap: wrap; gap: var(--space-s) var(--space-l); align-items: center; justify-content: space-between; }
  .footer__links { display: flex; flex-wrap: wrap; gap: 0 var(--space-m); }
  .footer__link, .footer__top { display: inline-flex; align-items: center; gap: 0.4em; min-height: var(--tap); font-family: var(--font-ui); font-size: var(--step-ui); letter-spacing: var(--tracking-ui); text-transform: var(--case-ui); color: var(--chrome-200); }
  @media (max-width: 52rem) {
    .footer { padding-top: var(--space-m); padding-bottom: var(--safe-b); }
    .footer__inner { gap: 0 var(--space-m); }
    .footer__rights { flex-basis: 100%; margin-bottom: var(--space-2xs); }
    .footer__link:active, .footer__top:active { color: var(--chrome-50); }
  }
  /* Firma enorme, cortada por abajo: contorno de plata, sin relleno */
  .footer__mark {
    margin: var(--space-l) 0 0;
    padding-inline: var(--gutter);
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-stretch: var(--stretch-display);
    font-size: clamp(1.8rem, 8.2vw, 9rem);
    line-height: 0.74;
    letter-spacing: var(--tracking-display);
    text-transform: var(--case-display);
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: var(--stroke) var(--chrome-600);
    height: 0.62em;
    overflow: hidden;
    user-select: none;
  }
</style>
