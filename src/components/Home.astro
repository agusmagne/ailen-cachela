---
import { type Lang } from '../lib/content';
import { isVisible } from '../lib/sections';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Listen from './Listen.astro';
import Music from './Music.astro';
import Projects from './Projects.astro';
import Shows from './Shows.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import HomeMore from './HomeMore.astro';
import LabTeaser from './lab/LabTeaser.astro';
import { router } from '../lib/routes';
import Footer from './Footer.astro';
import Dock from './Dock.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<Nav lang={lang} />
<main id="main">
  <Hero lang={lang} />
  {isVisible('escuchar') && <Listen lang={lang} />}
  {router.listed('lab') && <div class="wrap home-lab"><LabTeaser lang={lang} /></div>}
  {isVisible('musica') && <Music lang={lang} />}
  {isVisible('proyectos') && <Projects lang={lang} />}
  {isVisible('fechas') && <Shows lang={lang} />}
  {isVisible('sobre') && <About lang={lang} />}
  {isVisible('contacto') && <Contact lang={lang} />}
  <HomeMore lang={lang} />
</main>
<Footer lang={lang} />
<Dock lang={lang} />

<style>
  .home-lab { padding-block: var(--space-l) 0; }
</style>
